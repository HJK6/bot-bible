#!/usr/bin/env python3
"""CLI helper for SSM-backed credential management.

Usage:
    creds get <service>           Print full JSON blob (decrypted)
    creds get <service> <key>     Print a single field value
    creds set <service> <json>    Create or update a credential
    creds list                    List all stored services
    creds delete <service>        Delete a credential
"""

import json
import sys

import boto3

SSM_PREFIX = "/bartimaeus/creds/"
ssm = boto3.client("ssm", region_name="us-east-1")


def get_creds(service: str) -> dict:
    resp = ssm.get_parameter(Name=f"{SSM_PREFIX}{service}", WithDecryption=True)
    return json.loads(resp["Parameter"]["Value"])


def cmd_get(args):
    if not args:
        print("Usage: creds get <service> [key]", file=sys.stderr)
        sys.exit(1)
    service = args[0]
    try:
        creds = get_creds(service)
    except ssm.exceptions.ParameterNotFound:
        print(f"No credentials found for '{service}'", file=sys.stderr)
        sys.exit(1)
    if len(args) > 1:
        key = args[1]
        if key not in creds:
            print(f"Key '{key}' not found. Available: {', '.join(creds.keys())}", file=sys.stderr)
            sys.exit(1)
        print(creds[key])
    else:
        print(json.dumps(creds, indent=2))


def cmd_set(args):
    if len(args) < 2:
        print("Usage: creds set <service> '<json>'", file=sys.stderr)
        sys.exit(1)
    service = args[0]
    raw = " ".join(args[1:])
    try:
        creds = json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"Invalid JSON: {e}", file=sys.stderr)
        sys.exit(1)

    path = f"{SSM_PREFIX}{service}"
    # Check if it already exists
    try:
        existing = get_creds(service)
        print(f"Existing credential for '{service}' has fields: {', '.join(existing.keys())}")
        confirm = input("Overwrite? [y/N] ").strip().lower()
        if confirm != "y":
            print("Aborted.")
            sys.exit(0)
    except Exception:
        pass

    ssm.put_parameter(Name=path, Value=json.dumps(creds), Type="SecureString", Overwrite=True)
    print(f"Stored: {path} ({len(creds)} field(s))")


def cmd_list(_args):
    resp = ssm.get_parameters_by_path(Path=SSM_PREFIX, WithDecryption=False)
    params = resp.get("Parameters", [])
    while resp.get("NextToken"):
        resp = ssm.get_parameters_by_path(
            Path=SSM_PREFIX, WithDecryption=False, NextToken=resp["NextToken"]
        )
        params.extend(resp.get("Parameters", []))

    if not params:
        print("No credentials stored.")
        return

    print(f"{'Service':<20} {'Last Modified':<22} {'Version'}")
    print("-" * 55)
    for p in sorted(params, key=lambda x: x["Name"]):
        name = p["Name"].replace(SSM_PREFIX, "")
        modified = p["LastModifiedDate"].strftime("%Y-%m-%d %H:%M:%S")
        version = p["Version"]
        print(f"{name:<20} {modified:<22} v{version}")


def cmd_delete(args):
    if not args:
        print("Usage: creds delete <service>", file=sys.stderr)
        sys.exit(1)
    service = args[0]
    path = f"{SSM_PREFIX}{service}"
    confirm = input(f"Delete credential '{service}' from SSM? [y/N] ").strip().lower()
    if confirm != "y":
        print("Aborted.")
        sys.exit(0)
    try:
        ssm.delete_parameter(Name=path)
        print(f"Deleted: {path}")
    except ssm.exceptions.ParameterNotFound:
        print(f"No credential found for '{service}'", file=sys.stderr)
        sys.exit(1)


COMMANDS = {
    "get": cmd_get,
    "set": cmd_set,
    "list": cmd_list,
    "delete": cmd_delete,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(__doc__.strip())
        sys.exit(1)
    COMMANDS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
